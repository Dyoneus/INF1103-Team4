# Copy this file to .env and replace the placeholder before running ai_manager.py.
GROQ_API_KEY=your_groq_api_key_here

# Gemini (Google AI Studio key)
export AI_PROVIDER=openai
export AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
export AI_API_KEY_ENV=GEMINI_API_KEY      # names the variable that holds the key
export GEMINI_API_KEY="..."
export AI_MODEL="<model name copied from AI Studio>"
python ai_manager.py

# OpenRouter: same pattern, three values change
export AI_BASE_URL="https://openrouter.ai/api/v1"
export AI_API_KEY_ENV=OPENROUTER_API_KEY
export OPENROUTER_API_KEY="..."
export AI_MODEL="vendor/model:free"       # pick one that accepts image input

# Web interface only: the username and password the admin uses to sign in and
# see all reports. Leave either one empty to switch admin sign-in off.
SAFEREPORT_ADMIN_USERNAME=
SAFEREPORT_ADMIN_PASSWORD=
