# Copy this file to .env and fill in settings for the provider you use.
AI_PROVIDER=groq
AI_BASE_URL=
AI_MODEL=
AI_API_KEY_ENV=OPENAI_API_KEY

# Groq is used by default.
GROQ_API_KEY=your_groq_api_key_here

# For OpenAI or an OpenAI-compatible provider, set AI_PROVIDER=openai,
# provide AI_MODEL, and set AI_API_KEY_ENV to the name of the key below.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional web-interface settings. Admin sign-in is disabled unless both
# credentials are configured. Set a stable key to preserve sessions on restart.
SAFEREPORT_SECRET_KEY=
SAFEREPORT_ADMIN_USERNAME=
SAFEREPORT_ADMIN_PASSWORD=
