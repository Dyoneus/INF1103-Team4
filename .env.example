# Copy this file to .env and replace the placeholders before running ai_manager.py.

# Which AI provider(s) to use, in order. The next one is only tried if the
# previous one fails. Examples: groq (default) | gemini | groq,gemini | gemini,groq
AI_PROVIDER=groq

# Groq (needed when groq is in AI_PROVIDER). GROQ_MODEL is optional.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL= #optional

# Gemini (needed when gemini is in AI_PROVIDER). GEMINI_MODEL is required:
# copy a model name from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_preferred_gemini_model

# Web interface only: the username and password the admin uses to sign in and
# see all reports. Leave either one empty to switch admin sign-in off.
SAFEREPORT_SECRET_KEY=
SAFEREPORT_ADMIN_USERNAME=
SAFEREPORT_ADMIN_PASSWORD=
